# 仅忽略非代码产物：数据、日志、缓存、构建物、密钥、IDE、agent 运行时。
# 全部代码与配置（含 configs/、trading/、core/、testback/、scripts/、data 下的 *.py）均入库。

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- Framework runtime ----
.runs/
output/
logs/
*.log
*.pid
*.png

# ---- Data products (large, non-code)。保留 data 下的 Python 源码 ----
data/*
!data/*.py
!data/db/
data/db/**
!data/db/*.py
!data/db/**/
!data/db/**/*.py
results/
core/factors/results/

# ---- Training / verification artifacts ----
artifacts/rl/
artifacts/verification/
artifacts/factor_discovery/
dashboard/data.json
dashboard/data.js

# ---- MCP runtime ----
.mcp.json
.playwright-mcp/
**/.cache/

# ---- Per-project runtime ----
projects/

# ---- Agent runtime (仅忽略草稿与本地配置，已入库的 skills/rules 保留) ----
.agents/todos/
.claude/skills/
.claude/settings.local.json
.claude-runtime/

# ---- IDE ----
.idea/
.vscode/
.DS_Store
# ---- retired factor-discovery artifacts (preserve local research output) ----
llm_ga/_scratch/
llm_ga/_e2e.log
llm_ga/proposals/
